{
  "hosting": {
    "target": "laeh-madvid",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/MADvids",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/MADvids/:rest*",
        "destination": "/:rest*",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/nav.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
